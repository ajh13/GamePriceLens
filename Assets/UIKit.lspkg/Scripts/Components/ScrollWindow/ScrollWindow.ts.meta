  InputLines:
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Scrolling</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Axes, viewport, content size, and start position</span>"}'
    - '// @input bool _vertical = true {"hint":"Enable Vertical Scrolling"}'
    - '// @input bool _horizontal {"hint":"Enable Horizontal Scrolling"}'
    - '// @input vec2 _windowSize = "{32,32}" {"hint":"Size of masked window viewport in local space. <br><br>Note: to set dynamically, use the <code>windowSize</code> property"}'
    - '// @input vec2 _scrollDimensions = "{32,100}" {"hint":"Size of total scrollable area. Use -1 on an axis for unbounded scrolling. <br><br>Note: to set dynamically, use <code>setScrollDimensions</code>"}'
    - '// @input vec2 _scrollPosition = "{0,0}" {"label":"Scroll Position", "hint":"Initial scroll position in raw local units, top-left anchored: the default (0,0) shows the content top-left (the authored view). y grows scrolling down through content; x shrinks scrolling right."}'
    - "// @input string _contentOrigin = \"Center\" {\"label\":\"Content Origin\", \"hint\":\"Init-only. Where content-space (0,0) sits in the viewport. <code>Center</code> = classic authored-view frame (what you lay out around the origin is the initial view). <code>TopLeft</code> = (0,0) is the viewport's top-left corner (the scroll engine's page origin), so top-left-anchored layouts drop in at (0,0) with no half-window offset; content flows +x/−y.\", \"widget\":\"combobox\", \"values\":[{\"label\":\"Top Left\", \"value\":\"TopLeft\"}, {\"label\":\"Center\", \"value\":\"Center\"}]}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Snapping</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Rest-position policy: free scrolling, page snapping, or per-item detents</span>"}'
    - '// @input bool _scrollSnapping {"label":"Scroll Snapping", "hint":"Enable snapping to Snap Region multiples. Off = free momentum scrolling."}'
    - '// @input string _snapMode = "paging" {"hint":"Paging projects the continuous release position through its fling. Detent advances by gesture direction after the deadzone and re-snaps at idle, so the view always rests on a snap point.", "widget":"combobox", "values":[{"label":"Paging", "value":"paging"}, {"label":"Detent", "value":"detent"}], "showIf":"_scrollSnapping"}'
    - '// @input vec2 _snapRegion = "{8,8}" {"label":"Snap Region", "hint":"Per-axis size of each snap segment in local units.", "showIf":"_scrollSnapping"}'
    - '// @input string _pagingSnapCapMode = "gestureStart" {"label":"Paging Cap Mode", "hint":"Paging only: Gesture Start caps the final target from the gesture start (legacy maxSnapOne behavior). Release Page anchors the cap at the page nearest release, so the cap does not truncate drag travel; an opposing fling can still settle behind the release page.", "widget":"combobox", "values":[{"label":"Gesture Start (Legacy)", "value":"gestureStart"}, {"label":"Release Page (Cap at Release)", "value":"releasePage"}], "showIf":"_scrollSnapping"}'
    - '// @input int _maxSnapStepsPerFling = "0" {"label":"Max Snap Steps Per Fling", "hint":"Maximum snap steps. 0 = unlimited. Paging uses Paging Cap Mode; Detent preserves detents crossed by dragging.", "showIf":"_scrollSnapping"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Behavior</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Edge response and scroll feel</span>"}'
    - '// @input string _edgeMode = "elastic" {"hint":"Edge behavior: Elastic = rubber-band overscroll with spring-back; Clamped = hard stop at bounds. For an unbounded axis, set that axis of Scroll Dimensions to -1.", "widget":"combobox", "values":[{"label":"Elastic", "value":"elastic"}, {"label":"Clamped", "value":"clamped"}]}'
    - '// @input string _feel = "smooth" {"hint":"Deceleration/tuning bundle: Smooth = classic long glide; Crisp = short glide, firm feel.", "widget":"combobox", "values":[{"label":"Smooth", "value":"smooth"}, {"label":"Crisp", "value":"crisp"}]}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Rendering</span>"}'
    - '// @input bool _edgeFade {"hint":"Fade the content out at the edges toward Edge Fade Color <code>(rendering trick for transparency)</code>"}'
    - '// @input vec3 _edgeFadeColor = "{0.1254902,0.1254902,0.1254902}" {"hint":"Color the edge fade blends to. Defaults to the standard panel background; match your own backing panel color to fade over it.", "widget":"color", "showIf":"_edgeFade"}'
    - '// @input int _renderOrder = "0" {"hint":"Render order for the edge fade overlay. Leave at 0 unless you need the fade in a specific band relative to other chrome — it already layers over its own content via a depth bias plus hierarchy order.", "showIf":"_edgeFade"}'
