    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Focus Frame</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Move this field (or its panel) next to the keyboard while editing</span>"}'
    - "// @input bool enableFocusFrame = true {\"hint\":\"When enabled, this field docks to the system keyboard's focus-frame anchor while it is being edited, then returns to rest when editing ends. Requires the platform focus-frame source to be active; inert otherwise.\"}"
    - '// @input SceneObject focusFrameTarget {"label":"Focus Frame Target", "hint":"Object that moves toward the keyboard. Leave empty to move the nearest ancestor Frame (the whole panel), or this field itself if it has no Frame ancestor.", "showIf":"enableFocusFrame"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Alignment</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Horizontal text alignment</span>"}'
    - '// @input string _horizontalTextAlignment = "left" {"hint":"Alignment of the text within the text field.", "widget":"combobox", "values":[{"label":"Left", "value":"left"}, {"label":"Right", "value":"right"}]}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Input Type</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Validation and keyboard behavior</span>"}'
    - '// @input string inputType = "default" {"widget":"combobox", "values":[{"label":"Default", "value":"default"}, {"label":"Numeric", "value":"numeric"}, {"label":"Password", "value":"password"}, {"label":"Pin", "value":"pin"}, {"label":"URL", "value":"url"}, {"label":"Email", "value":"email"}]}'
    - '// @input string _dragAdjustAxis = "none" {"label":"Drag Adjust Axis", "hint":"Drag the field along this axis to step the number by its displayed precision (2.50 steps by 0.01); a unit after the number (50%) is kept. Ignored while the keyboard or voice input is active.", "widget":"combobox", "values":[{"label":"None", "value":"none"}, {"label":"Horizontal", "value":"horizontal"}, {"label":"Vertical", "value":"vertical"}], "showIf":"inputType", "showIfValue":"numeric"}'
    - '// @input bool contentRequiredOnDeactivate {"hint":"Throw error if unfocused with no input"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Action Slot</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Action slot follows horizontal text alignment. `password` input type overrides this with an eye-icon toggle.</span>"}'
    - '// @input string _actionSlot = "voiceInput" {"widget":"combobox", "values":[{"label":"None", "value":"none"}, {"label":"Voice Input", "value":"voiceInput"}, {"label":"Icon Change", "value":"iconChange"}]}'
