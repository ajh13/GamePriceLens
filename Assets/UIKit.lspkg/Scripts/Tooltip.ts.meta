    - "// @input float _tailOffsetAlongEdge = \"0\" {\"label\":\"Tail Offset\", \"hint\":\"Shifts the tail along the edge it's anchored to (centimeters). Positive moves toward +X for top/bottom edges, +Y for left/right edges.\", \"showIf\":\"_tailEnabled\", \"showIfValue\":true}"
    - '// @input bool _useIcon {"label":"Use Icon", "hint":"Display an icon alongside the tooltip text."}'
    - '// @input Asset.Texture _iconTexture {"label":"Icon", "hint":"Texture to display as the tooltip icon.", "showIf":"_useIcon", "showIfValue":true}'
    - '// @input float _iconSize = "1.0" {"label":"Icon Size", "hint":"Width and height of the icon in local-space centimeters.", "showIf":"_useIcon", "showIfValue":true}'
    - '// @input float _iconGap = "0.5" {"label":"Icon Gap", "hint":"Gap between the icon and the text in local-space centimeters.", "showIf":"_useIcon", "showIfValue":true}'
