// Skeleton block quad vertex stage.
//
// Scales the unit quad (position.x/y in [-0.5, 0.5], built by
// SkeletonBlockVisual's MeshBuilder) to the block rect in local-space
// centimeters, padded by aaPad so the fragment SDF's antialiasing fringe is
// never clipped by the geometry edge.
//
// IMPORTANT (Lens Studio custom-node semantics): outputs wired from a
// vertex-stage node into a fragment-stage node are NOT varyings — LS
// re-evaluates the expression at the fragment stage. This node outputs ONLY
// newPos; the fragment derives everything per pixel from the rendered
// position (same contract as SpinnerVertex.customCode).

input_vec2 blockSize;
input_float aaPad;

output_vec3 newPos;

void main()
{
    // At the vertex stage this is the raw position attribute (the unit quad).
    mediump vec3 basePos = system.getSurfacePositionObjectSpace();
    newPos = vec3(basePos.x * (blockSize.x + 2.0 * aaPad), basePos.y * (blockSize.y + 2.0 * aaPad), 0.0);
}
