      Title1: Float Parameter
      Title2: fadeStrength
    Node6:
      DependencyIndex: 6
      LevelID: 104
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_float radius;
            input_float borderSoftness;
            input_vec2 position;
            input_vec2 scale;
            input_vec4 fadeStrength;
            output_float dist;

            float saturate( float t ) {
            	return clamp( t, 0., 1. );
            }

            void main()
            {

            	// Straight per-edge linear fades (NOT a rounded-box SDF: the SDF's
            	// iso-lines bend around the window corners, which read as the fade
            	// "hooking" around content sides). Each edge ramps independently
            	// from the border inward; corners just take the strongest edge.
            	//
            	// Opaque plateau: full alpha over the outer 40% of the band, ramp
            	// compressed into the inner 60% — otherwise the band is opaque only
            	// at the outermost pixel row and a thin partial item near a window
            	// edge (a page boundary landing mid-item) ghosts through the ramp.
            	float ramp = borderSoftness * 0.6;
            	float dTop = (1.0 - position.y) * scale.y;
            	float dBottom = position.y * scale.y;
            	float dLeft = position.x * scale.x;
            	float dRight = (1.0 - position.x) * scale.x;
            	// fadeStrength = (top, bottom, left, right): each side's 0..1
            	// strength, driven from scroll position (0 at that scroll end).
            	float aTop = smoothstep( 0., ramp, borderSoftness - dTop ) * fadeStrength.x;
            	float aBottom = smoothstep( 0., ramp, borderSoftness - dBottom ) * fadeStrength.y;
            	float aLeft = smoothstep( 0., ramp, borderSoftness - dLeft ) * fadeStrength.z;
            	float aRight = smoothstep( 0., ramp, borderSoftness - dRight ) * fadeStrength.w;
            	dist = saturate( max( max( aTop, aBottom ), max( aLeft, aRight ) ) );

            }
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 104
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: RoundedBoxSDF
        borderSoftness:
