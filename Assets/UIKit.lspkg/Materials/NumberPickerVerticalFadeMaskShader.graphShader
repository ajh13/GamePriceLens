    Node5:
      DependencyIndex: 5
      LevelID: 104
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_float radius;
            input_float fadeSize;
            input_float maxOpacity;
            input_vec2 windowSize;
            input_vec2 position;
            output_float opacity;
            
            float saturate(float value) {
                return clamp(value, 0.0, 1.0);
            }
            
            float smootherstep(float value) {
                value = saturate(value);
                return value * value * value * (value * (value * 6.0 - 15.0) + 10.0);
            }
            
            float roundedRectangleCoverage(vec2 uv, vec2 rectangleSize, float cornerRadius) {
                vec2 safeSize = max(rectangleSize, vec2(0.0001));
                vec2 halfSize = safeSize * 0.5;
                float safeRadius = clamp(cornerRadius, 0.0, min(halfSize.x, halfSize.y));
                vec2 localPosition = (uv - vec2(0.5)) * safeSize;
                vec2 cornerDistance = abs(localPosition) - (halfSize - vec2(safeRadius));
                float signedDistance = length(max(cornerDistance, vec2(0.0)))
                    + min(max(cornerDistance.x, cornerDistance.y), 0.0)
                    - safeRadius;
                float antialiasWidth = max(fwidth(signedDistance), 0.0001);
                return 1.0 - smoothstep(-antialiasWidth, 0.0, signedDistance);
            }
            
            void main()
            {
                float edgeDistance = min(position.y, 1.0 - position.y);
                float verticalFade = 1.0 - smootherstep(edgeDistance / max(fadeSize, 0.0001));
                float roundedCoverage = roundedRectangleCoverage(position, windowSize, radius);
                opacity = saturate(maxOpacity) * verticalFade * roundedCoverage;
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 104
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: NumberPickerVerticalFadeMask
        UseExternalFile:
          Variable: false
        fadeSize:
          Connection0:
            NodeLevelID: 5
            PortID: Output
          Variable: 0.2
        maxOpacity:
          Connection0:
            NodeLevelID: 6
            PortID: Output
          Variable: 0.28
        ngs_Height:
          Variable: 420
        ngs_Version:
          String: 0.2.0
        opacity:
          IOType: 1
          Variable: 0.0
        position:
          Connection0:
            NodeLevelID: 0
            PortID: UVCoord
          Variable: [0.0, 0.0]
        radius:
          Connection0:
            NodeLevelID: 3
            PortID: Output
          Variable: 0.5
        windowSize:
          Connection0:
            NodeLevelID: 2
            PortID: Output
          Variable: [1.0, 1.0]
      PositionX: 221
